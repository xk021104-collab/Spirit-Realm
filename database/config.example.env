# ============================================================
# 《幻灵秘境》 数据库与消息中间件配置模板
# 用户提供配置后，可直接填入以下环境变量
# ============================================================

# 1. PostgreSQL 关系型数据库配置
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=huanling_mijing
PGSSL=false

# 2. Redis 高速缓存与实时会话配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 或者使用统一连接字符串:
# REDIS_URL=redis://:password@localhost:6379/0

# 3. RabbitMQ 异步事件消息队列配置
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# 或者使用统一连接字符串:
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
